<?xml version="1.0" encoding="utf-8"?>
<!-- Days, plans and settings follow the user to a new phone through the system backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sojourn.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="evidence/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sojourn.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="evidence/" />
    </device-transfer>
</data-extraction-rules>
