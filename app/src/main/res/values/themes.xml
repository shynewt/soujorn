<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash">#0B4F4C</color>

    <style name="Theme.Sojourn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F5FAF8</item>
    </style>

    <style name="Theme.Sojourn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sojourn</item>
    </style>
</resources>
